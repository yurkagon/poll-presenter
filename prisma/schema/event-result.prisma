model EventResult {
  id      String @id @default(uuid())
  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  placement      String[] @default([]) // ordered teamIds, best..worst (SCORE_ENTRY)
  scores         Json?    // { teamId: rawScore } manually entered for SCORE_ENTRY
  audienceRaw    Json?    @map("audience_raw") // { teamId: rawMedalPoints } (EURO audience tally)
  audienceVoters Int?     @map("audience_voters") // distinct voters, to normalize audience to 0..12
  juryRaw        Json?    @map("jury_raw") // { teamId: score 0..12 } (EURO jury, frozen at COMPLETE)
  computedPoints Json     @default("{}") @map("computed_points") // { teamId: finalPoints } frozen at COMPLETE

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("event_results")
}
