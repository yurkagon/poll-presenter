model EventResult {
  id      String @id @default(uuid())
  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  placement      String[] @default([]) // ordered teamIds, best..worst (SCORE_ENTRY)
  scores         Json?    // { teamId: rawScore } manually entered for SCORE_ENTRY
  audienceRaw    Json?    @map("audience_raw") // { teamId: rawScore } (EURO audience tally)
  juryRaw        Json?    @map("jury_raw") // { teamId: rawScore } (EURO jury, frozen at COMPLETE)
  computedPoints Json     @default("{}") @map("computed_points") // { teamId: finalPoints } frozen at COMPLETE

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("event_results")
}
