model Team {
  id      String  @id @default(uuid())
  name    String
  icon    String // emoji
  color   String // hex color
  order   Int
  eventId String? @map("event_id") // null = permanent camp team; set = ad-hoc team scoped to one event

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  participants Participant[]
  votes        Vote[]        @relation("VoteTargetTeam")
  juryScores   JuryScore[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("teams")
}
