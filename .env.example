# Server
PORT=3000

# CORS — comma-separated list of allowed origins
# Dev:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Prod example (set in your server environment, not committed to git):
# CORS_ORIGINS=https://conferenece-polls.dchurch.lviv.ua

# Database (Postgres via docker-compose)
POSTGRES_USER=poll
POSTGRES_PASSWORD=poll
POSTGRES_DB=poll_presenter
POSTGRES_PORT=5432

# Connection string used by Prisma (matches the docker-compose values above)
DATABASE_URL=postgresql://poll:poll@localhost:5432/poll_presenter?schema=public

# Redis (via docker-compose) — used for auth-session caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=poll

# Auth / JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d
# Cookie domain for the auth cookies (use "localhost" in dev)
COOKIE_DOMAIN=localhost
